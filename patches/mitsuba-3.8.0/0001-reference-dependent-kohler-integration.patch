index 22cef7237..c6e164174 100644
--- a/src/render/scene.cpp
+++ b/src/render/scene.cpp
@@ -401,6 +401,25 @@ MI_VARIANT Spectrum Scene<Float, Spectrum>::eval_emitter_direction(
     return ds.emitter->eval_direction(ref, ds, active);
 }

+MI_VARIANT Spectrum Scene<Float, Spectrum>::eval_emitter_connection(
+    const Interaction3f &ref, const SurfaceInteraction3f &si,
+    const DirectionSample3f &ds, Mask has_reference, Mask active) const {
+    MI_MASK_ARGUMENT(active);
+
+    Mask use_directional_eval =
+        active && has_reference &&
+        has_flag(ds.emitter->flags(active),
+                 EmitterFlags::ReferenceDependent);
+
+    Spectrum result =
+        ds.emitter->eval(si, active && !use_directional_eval);
+
+    if (dr::any_or<true>(use_directional_eval))
+        result += ds.emitter->eval_direction(ref, ds, use_directional_eval);
+
+    return result;
+}
+
 MI_VARIANT typename Scene<Float, Spectrum>::SilhouetteSample3f
 Scene<Float, Spectrum>::sample_silhouette(const Point3f &sample_,
                                           uint32_t flags, Mask active) const {
