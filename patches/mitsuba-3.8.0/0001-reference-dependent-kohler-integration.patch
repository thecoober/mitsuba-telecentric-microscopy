+    /**
+     * \brief Evaluate emission at the endpoint of a sampled path segment
+     *
+     * Ordinary emitters are evaluated using \ref Endpoint::eval(). Emitters
+     * marked as \ref EmitterFlags::ReferenceDependent instead require the
+     * preceding scattering interaction and are evaluated using
+     * \ref eval_emitter_direction(). This distinction is necessary for
+     * spatially conditioned illumination systems whose radiance cannot be
+     * inferred from a ray miss alone.
+     *
+     * \param ref
+     *    The preceding scattering interaction.
+     *
+     * \param si
+     *    The surface interaction at the emitter, or the invalid interaction
+     *    produced when the sampled ray escaped the scene.
+     *
+     * \param ds
+     *    Direction sample connecting \c ref to the emitter.
+     *
+     * \param has_reference
+     *    Whether \c ref is a valid preceding scattering interaction. This
+     *    must be false for directly visible emitters on primary rays.
+     *
+     * \return
+     *    Emitted radiance carried by the sampled path segment.
+     */
+    Spectrum eval_emitter_connection(const Interaction3f &ref,
+                                     const SurfaceInteraction3f &si,
+                                     const DirectionSample3f &ds,
+                                     Mask has_reference,
+                                     Mask active = true) const;
+
     //! @}
     // =============================================================

